{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ api_help }}</div>
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
          <fieldset>
            <legend>{{ text_api_settings }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-api-url">{{ entry_api_url }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_api_url" value="{{ shipping_gls_regular_api_url }}" placeholder="{{ entry_api_url }}" id="input-api-url" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-username">{{ entry_username }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_username" value="{{ shipping_gls_regular_username }}" placeholder="{{ entry_username }}" id="input-username" class="form-control" autocomplete="off" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-password">{{ entry_password }}</label>
              <div class="col-sm-10">
                <input type="password" name="shipping_gls_regular_password" value="{{ shipping_gls_regular_password }}" placeholder="{{ entry_password }}" id="input-password" class="form-control" autocomplete="new-password" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-client-number">{{ entry_client_number }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_client_number" value="{{ shipping_gls_regular_client_number }}" placeholder="{{ entry_client_number }}" id="input-client-number" class="form-control" />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_pickup_settings }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-pickup-name">{{ entry_pickup_name }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_pickup_name" value="{{ shipping_gls_regular_pickup_name }}" placeholder="{{ entry_pickup_name }}" id="input-pickup-name" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-pickup-street">{{ entry_pickup_street }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_pickup_street" value="{{ shipping_gls_regular_pickup_street }}" placeholder="{{ entry_pickup_street }}" id="input-pickup-street" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-pickup-house-number"><span data-toggle="tooltip" title="{{ help_house_number }}">{{ entry_pickup_house_number }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_pickup_house_number" value="{{ shipping_gls_regular_pickup_house_number }}" placeholder="{{ entry_pickup_house_number }}" id="input-pickup-house-number" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-pickup-house-info">{{ entry_pickup_house_info }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_pickup_house_number_info" value="{{ shipping_gls_regular_pickup_house_number_info }}" placeholder="{{ entry_pickup_house_info }}" id="input-pickup-house-info" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-pickup-city">{{ entry_pickup_city }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_pickup_city" value="{{ shipping_gls_regular_pickup_city }}" placeholder="{{ entry_pickup_city }}" id="input-pickup-city" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-pickup-postcode">{{ entry_pickup_postcode }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_pickup_postcode" value="{{ shipping_gls_regular_pickup_postcode }}" placeholder="{{ entry_pickup_postcode }}" id="input-pickup-postcode" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-pickup-country">{{ entry_pickup_country }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_pickup_country" value="{{ shipping_gls_regular_pickup_country }}" placeholder="{{ entry_pickup_country }}" id="input-pickup-country" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-pickup-email">{{ entry_pickup_email }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_pickup_email" value="{{ shipping_gls_regular_pickup_email }}" placeholder="{{ entry_pickup_email }}" id="input-pickup-email" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-pickup-phone">{{ entry_pickup_phone }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_pickup_phone" value="{{ shipping_gls_regular_pickup_phone }}" placeholder="{{ entry_pickup_phone }}" id="input-pickup-phone" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-pickup-days"><span data-toggle="tooltip" title="{{ help_pickup_days }}">{{ entry_pickup_days }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_pickup_days" value="{{ shipping_gls_regular_pickup_days }}" placeholder="{{ entry_pickup_days }}" id="input-pickup-days" class="form-control" />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_label_settings }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-order-prefix">{{ entry_order_prefix }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_order_prefix" value="{{ shipping_gls_regular_order_prefix }}" placeholder="{{ entry_order_prefix }}" id="input-order-prefix" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-content">{{ entry_content }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_content" value="{{ shipping_gls_regular_content }}" placeholder="{{ entry_content }}" id="input-content" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-printer-type">{{ entry_printer_type }}</label>
              <div class="col-sm-10">
                <select name="shipping_gls_regular_printer_type" id="input-printer-type" class="form-control">
                  {% for printer_type in printer_types %}
                  <option value="{{ printer_type }}"{% if printer_type == shipping_gls_regular_printer_type %} selected="selected"{% endif %}>{{ printer_type }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-print-position">{{ entry_print_position }}</label>
              <div class="col-sm-10">
                <select name="shipping_gls_regular_print_position" id="input-print-position" class="form-control">
                  {% for position in 1..4 %}
                  <option value="{{ position }}"{% if position == shipping_gls_regular_print_position %} selected="selected"{% endif %}>{{ position }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-hide-phone">{{ entry_hide_phone }}</label>
              <div class="col-sm-10">
                <select name="shipping_gls_regular_hide_phone" id="input-hide-phone" class="form-control">
                  {% if shipping_gls_regular_hide_phone %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_price_settings }}</legend>
            <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ price_help }}</div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-cost-hr">{{ entry_cost_hr }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_cost_hr" value="{{ shipping_gls_regular_cost_hr }}" placeholder="{{ entry_cost_hr }}" id="input-cost-hr" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-cost-hr-special">{{ entry_cost_hr_special }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_cost_hr_special" value="{{ shipping_gls_regular_cost_hr_special }}" placeholder="{{ entry_cost_hr_special }}" id="input-cost-hr-special" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-cost-eu-zone-1">{{ entry_cost_eu_zone_1 }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_cost_eu_zone_1" value="{{ shipping_gls_regular_cost_eu_zone_1 }}" placeholder="{{ entry_cost_eu_zone_1 }}" id="input-cost-eu-zone-1" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-cost-eu-zone-2">{{ entry_cost_eu_zone_2 }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_cost_eu_zone_2" value="{{ shipping_gls_regular_cost_eu_zone_2 }}" placeholder="{{ entry_cost_eu_zone_2 }}" id="input-cost-eu-zone-2" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-cost-eu-zone-3">{{ entry_cost_eu_zone_3 }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_cost_eu_zone_3" value="{{ shipping_gls_regular_cost_eu_zone_3 }}" placeholder="{{ entry_cost_eu_zone_3 }}" id="input-cost-eu-zone-3" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-cost-eu-zone-4">{{ entry_cost_eu_zone_4 }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_cost_eu_zone_4" value="{{ shipping_gls_regular_cost_eu_zone_4 }}" placeholder="{{ entry_cost_eu_zone_4 }}" id="input-cost-eu-zone-4" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-cost-eu-zone-5">{{ entry_cost_eu_zone_5 }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_cost_eu_zone_5" value="{{ shipping_gls_regular_cost_eu_zone_5 }}" placeholder="{{ entry_cost_eu_zone_5 }}" id="input-cost-eu-zone-5" class="form-control" />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_store_settings }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-tax-class">{{ entry_tax_class }}</label>
              <div class="col-sm-10">
                <select name="shipping_gls_regular_tax_class_id" id="input-tax-class" class="form-control">
                  <option value="0">{{ text_none }}</option>
                  {% for tax_class in tax_classes %}
                  <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_gls_regular_tax_class_id %} selected="selected"{% endif %}>{{ tax_class.title }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
              <div class="col-sm-10">
                <select name="shipping_gls_regular_geo_zone_id" id="input-geo-zone" class="form-control">
                  <option value="0">{{ text_all_zones }}</option>
                  {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_gls_regular_geo_zone_id %} selected="selected"{% endif %}>{{ geo_zone.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="shipping_gls_regular_status" id="input-status" class="form-control">
                  {% if shipping_gls_regular_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_gls_regular_sort_order" value="{{ shipping_gls_regular_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
