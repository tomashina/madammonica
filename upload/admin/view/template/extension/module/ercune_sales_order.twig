{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-exchange"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <fieldset>
            <legend>{{ text_api }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="module_ercune_sales_order_status" id="input-status" class="form-control">
                  {% if module_ercune_sales_order_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-api-url"><span data-toggle="tooltip" title="{{ help_api_url }}">{{ entry_api_url }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="module_ercune_sales_order_api_url" value="{{ module_ercune_sales_order_api_url }}" placeholder="{{ entry_api_url }}" id="input-api-url" class="form-control" />
                {% if error_api_url %}<div class="text-danger">{{ error_api_url }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-username">{{ entry_username }}</label>
              <div class="col-sm-10">
                <input type="text" name="module_ercune_sales_order_username" value="{{ module_ercune_sales_order_username }}" placeholder="{{ entry_username }}" id="input-username" class="form-control" />
                {% if error_username %}<div class="text-danger">{{ error_username }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-secret-key">{{ entry_secret_key }}</label>
              <div class="col-sm-10">
                <input type="text" name="module_ercune_sales_order_secret_key" value="{{ module_ercune_sales_order_secret_key }}" placeholder="{{ entry_secret_key }}" id="input-secret-key" class="form-control" />
                {% if error_secret_key %}<div class="text-danger">{{ error_secret_key }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-token">{{ entry_token }}</label>
              <div class="col-sm-10">
                <input type="text" name="module_ercune_sales_order_token" value="{{ module_ercune_sales_order_token }}" placeholder="{{ entry_token }}" id="input-token" class="form-control" />
                {% if error_token %}<div class="text-danger">{{ error_token }}</div>{% endif %}
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_payload }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-send-email"><span data-toggle="tooltip" title="{{ help_send_email }}">{{ entry_send_email }}</span></label>
              <div class="col-sm-10">
                <select name="module_ercune_sales_order_send_email" id="input-send-email" class="form-control">
                  {% if module_ercune_sales_order_send_email %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-valid-until-days">{{ entry_valid_until_days }}</label>
              <div class="col-sm-10">
                <input type="number" min="0" name="module_ercune_sales_order_valid_until_days" value="{{ module_ercune_sales_order_valid_until_days }}" placeholder="{{ entry_valid_until_days }}" id="input-valid-until-days" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-default-country">{{ entry_default_country }}</label>
              <div class="col-sm-10">
                <input type="text" maxlength="2" name="module_ercune_sales_order_default_country" value="{{ module_ercune_sales_order_default_country }}" placeholder="{{ entry_default_country }}" id="input-default-country" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-company-field"><span data-toggle="tooltip" title="{{ help_custom_fields }}">{{ entry_company_custom_field_id }}</span></label>
              <div class="col-sm-10">
                <input type="number" min="0" name="module_ercune_sales_order_company_custom_field_id" value="{{ module_ercune_sales_order_company_custom_field_id }}" placeholder="{{ entry_company_custom_field_id }}" id="input-company-field" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-tax-field"><span data-toggle="tooltip" title="{{ help_custom_fields }}">{{ entry_tax_custom_field_id }}</span></label>
              <div class="col-sm-10">
                <input type="number" min="0" name="module_ercune_sales_order_tax_custom_field_id" value="{{ module_ercune_sales_order_tax_custom_field_id }}" placeholder="{{ entry_tax_custom_field_id }}" id="input-tax-field" class="form-control" />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_catalogue }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-ensure-products"><span data-toggle="tooltip" title="{{ help_ensure_products }}">{{ entry_ensure_products }}</span></label>
              <div class="col-sm-10">
                <select name="module_ercune_sales_order_ensure_products" id="input-ensure-products" class="form-control">
                  {% if module_ercune_sales_order_ensure_products %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-shipping-product-code">{{ entry_shipping_product_code }}</label>
              <div class="col-sm-10">
                <input type="text" name="module_ercune_sales_order_shipping_product_code" value="{{ module_ercune_sales_order_shipping_product_code }}" placeholder="{{ entry_shipping_product_code }}" id="input-shipping-product-code" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-shipping-product-name">{{ entry_shipping_product_name }}</label>
              <div class="col-sm-10">
                <input type="text" name="module_ercune_sales_order_shipping_product_name" value="{{ module_ercune_sales_order_shipping_product_name }}" placeholder="{{ entry_shipping_product_name }}" id="input-shipping-product-name" class="form-control" />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_payment }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-method-cod">{{ entry_method_cod }}</label>
              <div class="col-sm-10">
                <input type="text" name="module_ercune_sales_order_method_cod" value="{{ module_ercune_sales_order_method_cod }}" placeholder="{{ entry_method_cod }}" id="input-method-cod" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-method-bank-transfer">{{ entry_method_bank_transfer }}</label>
              <div class="col-sm-10">
                <input type="text" name="module_ercune_sales_order_method_bank_transfer" value="{{ module_ercune_sales_order_method_bank_transfer }}" placeholder="{{ entry_method_bank_transfer }}" id="input-method-bank-transfer" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-method-default">{{ entry_method_default }}</label>
              <div class="col-sm-10">
                <input type="text" name="module_ercune_sales_order_method_default" value="{{ module_ercune_sales_order_method_default }}" placeholder="{{ entry_method_default }}" id="input-method-default" class="form-control" />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Log</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-debug"><span data-toggle="tooltip" title="{{ help_debug }}">{{ entry_debug }}</span></label>
              <div class="col-sm-10">
                <select name="module_ercune_sales_order_debug" id="input-debug" class="form-control">
                  {% if module_ercune_sales_order_debug %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
