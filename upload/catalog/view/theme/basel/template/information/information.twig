{{ header }}

{% if is_layout_kids or is_layout_underwear or is_layout_kozo_men or is_layout_kozo_women %}

<style>
.breadcrumb-holder{
  display: none;
}
</style>



<div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">
    {{ content_top }}
  
     
      {{ content_bottom }}
     </div>
    {{ column_right }}
  </div>
</div>



{% else %}
  <div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }} mb-50 infopage">
    {{ content_top }}
      <h1 id="page-title">{{ heading_title }}</h1>
      {{ description }}
      {{ content_bottom }}
     </div>
    {{ column_right }}
  </div>
</div>
{% endif %}




{% if faq_schema %}<script type="application/ld+json">{{ faq_schema }}</script>{% endif %}
{{ footer }}
