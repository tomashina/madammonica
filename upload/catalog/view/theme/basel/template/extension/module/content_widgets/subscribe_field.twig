<div class="newsletter-wrap">
    <div class="input-group sign-up-field">
        <span class="sign-up-respond" id="subscribe-respond{{ module }}"></span>
        <input type="text" id="subscribe-module{{ module }}" name="email" class="form-control margin-b15" placeholder="{{ basel_subscribe_email }}" />
        <br>
     
        <label>   <input type="checkbox" name="terms" value="1" id="agree-reg">   {{ text_agree }}</label>

        <span class="input-group-btn valign-top" >
            <a class="btn btn-white nowrap" onclick="subscribe({{ module }});"><span class="nowrap">{{ basel_subscribe_btn }}</span></a>
        </span>
    </div>

</div>
