<form class="full-search-wrapper" action="index.php" method="get">
<input type="hidden" name="route" value="product/search" />
<div class="search-field search-main">
<input type="text" name="search" value="{{ search }}" placeholder="{{ basel_text_search }}" class="form-control main-search-input" />
</div>
<button type="submit" class="search-button do-search main" aria-label="{{ basel_text_search }}" style="-webkit-appearance:none;appearance:none;padding:0;margin:0;border:0;border-radius:0;background:transparent;box-shadow:none;color:inherit;font:inherit;cursor:pointer;">
<span class="ag-icon-magnifier icon" aria-hidden="true"></span>
</button>
</form>
<script>
$(document).ready(function() {
$('.search-holder-mobile input[name=\'search\']').attr("placeholder", "{{ basel_text_search }}").attr("value", "{{ search }}");
});
</script>
