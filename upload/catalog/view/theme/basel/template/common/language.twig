{% if languages|length > 1 %}
<div class="option">
<h4>{{ text_language }}</h4>
{% for language in languages %}
{% if language.code == code %}
<p><span class="anim-underline active">{{ language.name }}</span></p>
{% else %}
<p><a class="anim-underline" href="{{ language.href }}" hreflang="{{ language.code|slice(0, 2) }}">
{{ language.name }}</a></p>
{% endif %}
{% endfor %}
<select name="language-select" id="language-select" class="-hidden-md -hidden-lg">
{% for language in languages %}
{% if language.code == code %}
<option value="{{ language.href }}" selected="selected">{{ language.name }}</option>
{% else %}
<option value="{{ language.href }}">{{ language.name }}</option>
{% endif %}
{% endfor %}
</select>
<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-language">
<input type="hidden" name="code" id="lang-code" value="" />
<input type="hidden" name="redirect" value="{{ redirect }}" />
</form>
<script>
$(document).ready(function() {
$('.mobile-lang-curr').addClass('has-l');
$('#language-select').appendTo('.mobile-lang-curr');
$('#language-select').on('change', function() {
  if (this.value) window.location.href = this.value;
});
});
</script>
</div>
{% endif %}
